<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:version="1.2" office:mimetype="application/vnd.oasis.opendocument.text">
<office:automatic-styles><style:style style:name="VerticalCell" style:family="table-cell"><style:table-cell-properties style:writing-mode="tb-rl" fo:background-color="#E2F0D9" fo:border="0.75pt solid #548235"/></style:style><style:style style:name="PlainCell" style:family="table-cell"><style:table-cell-properties fo:border="0.75pt solid #548235"/></style:style></office:automatic-styles>
<office:body><office:text><text:p>Merged table</text:p><table:table table:name="Merged"><table:table-column table:number-columns-repeated="3"/><table:table-row><table:table-cell table:style-name="VerticalCell" table:number-rows-spanned="2"><text:p>Vertical</text:p></table:table-cell><table:table-cell table:style-name="PlainCell" table:number-columns-spanned="2"><text:p>Header merged</text:p></table:table-cell><table:covered-table-cell/></table:table-row><table:table-row><table:covered-table-cell/><table:table-cell table:style-name="PlainCell"><text:p>Cell B</text:p></table:table-cell><table:table-cell table:style-name="PlainCell"><text:p>Cell C</text:p></table:table-cell></table:table-row></table:table></office:text></office:body></office:document>
