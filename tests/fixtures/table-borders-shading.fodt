<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:version="1.2" office:mimetype="application/vnd.oasis.opendocument.text">
<office:automatic-styles><style:style style:name="TableCellRed" style:family="table-cell"><style:table-cell-properties fo:background-color="#FFF2CC" fo:border="0.75pt solid #C00000" fo:padding="0.08in"/></style:style><style:style style:name="TableCellBlue" style:family="table-cell"><style:table-cell-properties fo:background-color="#DDEBF7" fo:border="1pt solid #0070C0" fo:padding="0.08in"/></style:style></office:automatic-styles>
<office:body><office:text><text:p>Styled table</text:p><table:table table:name="Styled"><table:table-column table:number-columns-repeated="2"/><table:table-row><table:table-cell table:style-name="TableCellRed"><text:p>Red A</text:p></table:table-cell><table:table-cell ><text:p>Blue B</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell ><text:p>Blue C</text:p></table:table-cell><table:table-cell ><text:p>Red D</text:p></table:table-cell></table:table-row></table:table></office:text></office:body></office:document>
